{
	"$schema": "https://json.schemastore.org/package",
	"name": "directus-operation-index",
	"version": "0.2.0",
	"description": "A Directus Flow operation that keeps collections in sync with Algolia, Meilisearch or Typesense",
	"keywords": [
		"algolia",
		"directus",
		"directus-extension",
		"directus-extension-operation",
		"meilisearch",
		"search",
		"sync",
		"typesense"
	],
	"homepage": "https://github.com/ComfortablyCoding/directus-operation-index#readme",
	"bugs": {
		"url": "https://github.com/ComfortablyCoding/directus-operation-index/issues"
	},
	"license": "MIT",
	"author": {
		"name": "ComfortablyCoding",
		"url": "https://github.com/ComfortablyCoding"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ComfortablyCoding/directus-operation-index.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@algolia/client-search": "5.59.0",
		"@directus/errors": "3.0.0",
		"@directus/extensions-sdk": "18.0.6",
		"@directus/types": "18.0.0",
		"@types/node": "22.20.5",
		"meilisearch": "0.62.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"typescript": "7.0.2",
		"typesense": "3.1.1",
		"vitest": "5.0.3"
	},
	"icon": "manage_search",
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.3.4",
	"directus:extension": {
		"type": "operation",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"source": {
			"app": "src/app.ts",
			"api": "src/api.ts"
		},
		"host": "^11.0.0 || ^12.0.0"
	}
}
